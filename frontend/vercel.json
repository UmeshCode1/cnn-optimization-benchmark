{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://cnn-optimization-benchmark.onrender.com/api/:match*"
    },
    {
      "source": "/((?!api/|assets/|favicon.svg|icons.svg|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
